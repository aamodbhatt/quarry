# Copy to .env and fill in. .env is git-ignored.
# OpenRouter key (https://openrouter.ai/keys). Leave empty to use --offline only.
OPENROUTER_API_KEY=

# Optional exporters (also switch them on in configs/quarry.toml [tracing]).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quarry
